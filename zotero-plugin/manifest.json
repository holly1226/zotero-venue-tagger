{
  "manifest_version": 2,
  "name": "HCI Venue Tagger",
  "version": "0.5.2",
  "description": "Identifies HCI journals and conferences, imports custom venue lists, and shows compact classification badges.",
  "author": "holly1226",
  "homepage_url": "https://github.com/holly1226/zotero-venue-tagger",
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  },
  "applications": {
    "zotero": {
      "id": "zotero-venue-tagger@holly1226.github.io",
      "update_url": "https://raw.githubusercontent.com/holly1226/zotero-venue-tagger/main/updates.json",
      "strict_min_version": "8.0",
      "strict_max_version": "10.0.*"
    }
  }
}
